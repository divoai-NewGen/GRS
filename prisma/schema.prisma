generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("BUSINESS_OWNER") // "ADMIN" | "BUSINESS_OWNER"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  businesses   Business[]
  auditLogs    AuditLog[]
}

model Business {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  businessType       String    @default("OTHER") // SALON, RESTAURANT, CAFE, HOTEL, GYM, CLINIC, DENTIST, RETAIL, AUTO_SERVICE, REAL_ESTATE, OTHER
  description        String?
  logoUrl            String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String?
  googleBusinessName String?
  googleReviewUrl    String
  status             String            @default("ACTIVE") // ACTIVE, INACTIVE
  planType           String            @default("BASIC") // BASIC, PREMIUM
  customTags         String? // JSON array of positive tags
  recommendedReviews String? // JSON array of template reviews
  negativeFeedbackFilter Boolean       @default(true) // Filter 1-3 stars to private feedback in Premium
  ownerId            String?
  owner              User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  cards              Card[]
  scans              Scan[]
  feedbacks          PrivateFeedback[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([slug])
  @@index([ownerId])
  @@index([status])
  @@index([planType])
}

model Card {
  id            String    @id @default(cuid())
  cardCode      String    @unique
  publicToken   String    @unique
  status        String    @default("UNASSIGNED") // UNASSIGNED, ASSIGNED, DISABLED
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  label         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  assignedAt    DateTime?
  deactivatedAt DateTime?
  scans         Scan[]

  @@index([publicToken])
  @@index([cardCode])
  @@index([businessId])
  @@index([status])
}

model Scan {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scannedAt  DateTime @default(now())
  ipHash     String
  userAgent  String?
  deviceType String? // Mobile, Desktop, Tablet, Bot
  browser    String? // Chrome, Safari, Firefox, Edge, etc.
  os         String? // iOS, Android, macOS, Windows, Linux
  country    String?
  city       String?
  referrer   String?

  @@index([cardId])
  @@index([businessId])
  @@index([scannedAt])
  @@index([ipHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CARD_CREATED, CARD_ASSIGNED, CARD_REASSIGNED, CARD_DISABLED, BUSINESS_CREATED, BUSINESS_UPDATED, BUSINESS_DELETED, GOOGLE_REVIEW_URL_UPDATED
  entityType String // CARD, BUSINESS, USER, SETTING
  entityId   String?
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model AppSetting {
  id                 String   @id @default("default")
  brandName          String   @default("GrowBroo")
  domain             String   @default("growbroo.com")
  supportEmail       String   @default("support@growbroo.com")
  primaryColor       String   @default("#006B21")
  secondaryColor     String   @default("#10251A")
  defaultCardText    String   @default("Scan to share your honest feedback")
  dataRetentionDays  Int      @default(365)
  rateLimitPerMinute Int      @default(60)
  updatedAt          DateTime @updatedAt
}

model PrivateFeedback {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cardId        String?
  rating        Int // 1, 2, or 3
  tags          String? // JSON array of selected issues
  feedback      String
  customerName  String?
  customerPhone String?
  createdAt     DateTime @default(now())
  status        String   @default("UNREAD") // UNREAD, RESOLVED

  @@index([businessId])
  @@index([createdAt])
  @@index([status])
}

model Inquiry {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  businessName String?
  plan         String   @default("BASIC") // "BASIC" | "PREMIUM"
  message      String?
  status       String   @default("NEW") // "NEW", "CONTACTED", "CONVERTED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

